# Copy this file to .env and fill in your own keys. Never commit .env itself.

# Enables real GPT responses in Ask Gita AI, and the Indian-English TTS voice.
# Without it, the app falls back to the offline knowledge engine and browser voices.
OPENAI_API_KEY=

# Optional overrides
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TTS_VOICE=onyx

# Optional alternative Indian-English voice source instead of OpenAI TTS
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=en-IN-NeerjaNeural
